# LOB Matrix runtime environment.
#
# Copy outside the repository, restrict it to the service account:
#   install -m 0600 /dev/null /path/to/orderbook-engine.env
#
# Never commit broker credentials or provider tokens.

# M6P1S1: mock dashboard mode for deployment verification.
LOBMATRIX_DASHBOARD_MOCK_FEED_ENABLED=true

# Infrastructure time uses UTC. Market schedules must explicitly use
# Asia/Kolkata in systemd timers or application scheduling configuration.
TZ=UTC

# M6P1S2 examples only; leave unset until provider integration exists.
# ZERODHA_API_KEY=
# ZERODHA_ACCESS_TOKEN=
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=
